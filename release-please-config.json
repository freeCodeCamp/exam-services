{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "801cfc7ba2c868db5f310c4b91173548e2dcd09f",
  "plugins": ["cargo-workspace"],
  "always-update": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "group-pull-request-title-pattern": "chore: release packages ${branch}",
  "packages": {
    "exam-utils": {
      "release-type": "rust",
      "component": "exam-utils"
    },
    "js-api": {
      "release-type": "simple",
      "component": "js-api",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    },
    "moderation-service": {
      "release-type": "rust",
      "component": "moderation-service"
    },
    "prisma": {
      "release-type": "rust",
      "component": "prisma"
    },
    "script": {
      "release-type": "simple",
      "component": "script",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  }
}
